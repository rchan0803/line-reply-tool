# LINE Messaging API（公式LINE / mainアカウント）
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 購入者専用LINE（paidアカウント / Webhook URLは /webhook/paid）
# LINE_CHANNEL_SECRET_PAID=
# LINE_CHANNEL_ACCESS_TOKEN_PAID=
# ELME_WEBHOOK_URL_PAID=

# 各アカウントが参照するテンプレのシート名（カンマ区切り、省略時は下記デフォルト）
# MANUAL_SHEETS_MAIN=公式LINE
# MANUAL_SHEETS_PAID=有料鑑定専用LINE,相談内容ヒアリング

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets
GOOGLE_SHEET_ID=your_spreadsheet_id_here
# スプレッドシートのURLの /d/ と /edit の間の文字列
# 例: https://docs.google.com/spreadsheets/d/xxxxxxxx/edit → xxxxxxxx

GOOGLE_CREDENTIALS_FILE=credentials.json
# サービスアカウントのJSONファイルパス
# （サーバー環境ではファイルの代わりに GOOGLE_CREDENTIALS_JSON にJSON文字列を設定）

# 管理画面のパスワード（未設定だと誰でも閲覧可能になるので本番では必ず設定）
ADMIN_PASSWORD=your_admin_password_here

# データベースの保存先（Railwayではボリュームを /data にマウントして以下を設定）
# DB_PATH=/data/line_chat.db

# エルメへの転送先Webhook URL（エルメ管理画面のMessaging API設定で確認）
# ELME_WEBHOOK_URL=https://cb.lmes.jp/line/callback/add/xxxxxx
